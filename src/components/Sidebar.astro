---
interface Props {
  profile?: {
    name?: string;
    role?: string;
    bio?: string;
    links?: {
      linkedin?: string;
      github?: string;
    };
  };
}

const { profile } = Astro.props;

const name = profile?.name || "Magalí Godoy";
const role = profile?.role || "Functional Analyst | QA Specialist | Project Management";
const linkedin = profile?.links?.linkedin || "https://linkedin.com/in/magali-d-godoy";
const github = profile?.links?.github || "https://github.com";

const skills = [
  { group: "Análisis Funcional & Gestión", items: ["Relevamiento de Requisitos", "Casos de Uso", "BPMN / UML", "Scrum", "Kanban", "Jira / Confluence"] },
  { group: "Diseño UX/UI & Producto", items: ["Figma", "Wireframing", "Prototipado", "User Research", "Arquitectura de Información"] },
  { group: "QA & Testing", items: ["Estrategias de Pruebas", "Casos de Prueba", "BDD (Given-When-Then)", "Postman (API Testing)", "Reporte de Bugs"] },
  { group: "Business Intelligence & Datos", items: ["Power BI", "Modelado de Datos", "Métricas & KPIs", "Dashboards Ejecutivos"] },
  { group: "Desarrollo Frontend", items: ["Astro", "Tailwind CSS", "JavaScript", "TypeScript", "Git / GitHub"] },
  { group: "Desarrollo Backend & Base de Datos", items: ["Node.js", "Express", "MySQL", "MongoDB", "REST APIs", "Postman", "JSON"] }
];

const education = [
  { title: "Fullstack Developer", entity: "SoyHenry", year: "2023" },
  { title: "Oratoria y comunicación asertiva", entity: "OPI Franco Pisso", year: "2025" },
  { title: "Project Manager | Scrum Master (PSM I)", entity: "Scrum.org", year: "2026" },
  { title: "Diseño UX/UI (Especialización Autodidacta)", entity: "Cursos & Práctica", year: "2024 - Presente" },
  { title: "Certificación en Calidad del Software(QA)", entity: "ISTQB CTFL", year: "2026" },
  { title: "Inglés B2 First (FCE)", entity: "En preparación", year: "2026" }
];
---

<!-- 📱 BOTÓN HAMBURGUESA MÓVIL -->
<div class="lg:hidden p-4 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between sticky top-0 z-30">
  <div class="flex items-center gap-2">
    <div class="w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold text-xs shadow-sm">
      MG
    </div>
    <span class="text-xs font-bold text-slate-900 dark:text-slate-100">{name}</span>
  </div>
  <button 
    id="mobile-menu-button"
    class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 shadow-xs flex items-center justify-center cursor-pointer"
    aria-label="Abrir menú"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>
</div>

<!-- 🌑 CAPA DE FONDO OSCURA (BACKDROP MÓVIL) -->
<div id="sidebar-backdrop" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-40 hidden lg:hidden transition-opacity"></div>

<!-- SIDEBAR PRINCIPAL -->
<aside 
  id="sidebar" 
  class="fixed lg:sticky top-0 inset-y-0 left-0 z-50 w-64 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 p-3 flex flex-col justify-between h-screen -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl lg:shadow-none shrink-0"
>
  <div class="space-y-4">
    <!-- Header Sidebar -->
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800 pt-2 lg:pt-0">
      <div id="sidebar-header-info" class="flex items-center gap-2.5 overflow-hidden">
        <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-sm">
          MG
        </div>
        <div class="sidebar-text truncate">
          <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">{name}</h2>
          <span class="text-[10px] font-medium text-emerald-600 dark:text-emerald-400 block">Portfolio</span>
        </div>
      </div>

      <!-- Botón Colapsar Desktop -->
      <button 
        id="sidebar-toggle" 
        class="hidden lg:flex p-1.5 rounded-md text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 dark:text-slate-400 transition-colors cursor-pointer shrink-0"
        title="Ocultar/Mostrar barra lateral"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19l-7-7 7-7m8 14l-7-7 7-7"></path>
        </svg>
      </button>
    </div>

    <!-- Menú -->
    <nav class="space-y-1.5">
      <p class="sidebar-text text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 px-2 mb-1">
        Información General
      </p>

      <button 
        id="btn-open-about"
        class="w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all text-xs font-semibold cursor-pointer group border border-transparent hover:border-slate-200 dark:hover:border-slate-700"
      >
        <div class="flex items-center gap-2.5 overflow-hidden">
          <span class="text-base group-hover:scale-110 transition-transform shrink-0">👤</span>
          <span class="sidebar-text truncate">Sobre Mí</span>
        </div>
        <span class="sidebar-text text-slate-400 group-hover:text-emerald-500 text-xs shrink-0">↗</span>
      </button>

      <button 
        id="btn-open-skills"
        class="w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all text-xs font-semibold cursor-pointer group border border-transparent hover:border-slate-200 dark:hover:border-slate-700"
      >
        <div class="flex items-center gap-2.5 overflow-hidden">
          <span class="text-base group-hover:scale-110 transition-transform shrink-0">⚡</span>
          <span class="sidebar-text truncate">Core Skills</span>
        </div>
        <span class="sidebar-text text-slate-400 group-hover:text-emerald-500 text-xs shrink-0">↗</span>
      </button>

      <button 
        id="btn-open-edu"
        class="w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all text-xs font-semibold cursor-pointer group border border-transparent hover:border-slate-200 dark:hover:border-slate-700"
      >
        <div class="flex items-center gap-2.5 overflow-hidden">
          <span class="text-base group-hover:scale-110 transition-transform shrink-0">🎓</span>
          <span class="sidebar-text truncate">Educación & Cursos</span>
        </div>
        <span class="sidebar-text text-slate-400 group-hover:text-emerald-500 text-xs shrink-0">↗</span>
      </button>
    </nav>
  </div>

  <!-- Links Inferiores -->
  <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-1">
    <a 
      href={linkedin} 
      target="_blank" 
      rel="noopener noreferrer"
      class="flex items-center justify-between px-2.5 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium transition-colors"
    >
      <span class="flex items-center gap-2 overflow-hidden truncate">
        <span class="shrink-0">💼</span> 
        <span class="sidebar-text truncate">LinkedIn</span>
      </span>
      <span class="sidebar-text text-xs shrink-0">↗</span>
    </a>
    <a 
      href={github} 
      target="_blank" 
      rel="noopener noreferrer"
      class="flex items-center justify-between px-2.5 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium transition-colors"
    >
      <span class="flex items-center gap-2 overflow-hidden truncate">
        <span class="shrink-0">🐙</span> 
        <span class="sidebar-text truncate">GitHub</span>
      </span>
      <span class="sidebar-text text-xs shrink-0">↗</span>
    </a>
  </div>
</aside>

<!-- MODAL SOBRE MÍ -->
<div id="modal-about" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl max-w-xl w-full p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800 mb-4">
      <div class="flex items-center gap-2">
        <span class="text-xl">👤</span>
        <h3 class="font-bold text-base text-slate-900 dark:text-white">Sobre Mí</h3>
      </div>
      <button class="close-info-modal text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xl font-bold cursor-pointer">✕</button>
    </div>
    
    <div class="space-y-4 text-xs text-slate-700 dark:text-slate-300">
      <div>
        <h4 class="font-bold text-slate-900 dark:text-slate-100 mb-1.5 text-sm">De la curiosidad técnica a la gestión de valor</h4>
        <p class="leading-relaxed bg-slate-50 dark:bg-slate-950 p-3 rounded-lg border border-slate-200/60 dark:border-slate-800/60">
          Mi recorrido profesional combina una sólida base en desarrollo fullstack, análisis funcional y calidad de software (QA). Esta visión integral me permite entender el ciclo de vida del producto desde múltiples ángulos: sé lo que implica escribir código, conozco la importancia de especificar requerimientos sin ambigüedades y entiendo el rigor necesario para que una funcionalidad llegue a producción sin fallos.
        </p>
      </div>

      <div>
        <h4 class="font-bold text-slate-900 dark:text-slate-100 mb-2">Mis pilares de trabajo</h4>
        <ul class="space-y-2 bg-slate-50 dark:bg-slate-950 p-3 rounded-lg border border-slate-200/60 dark:border-slate-800/60">
          <li>
            <strong class="text-slate-900 dark:text-slate-100">Claridad sobre suposiciones:</strong> Me enfoco en hacer las preguntas correctas al inicio para evitar reprocesos costosos.
          </li>
          <li>
            <strong class="text-slate-900 dark:text-slate-100">Calidad como cultura:</strong> Concibo QA como una mentalidad que acompaña todo el desarrollo, no solo como la etapa final.
          </li>
          <li>
            <strong class="text-slate-900 dark:text-slate-100">Agilidad y mejora continua:</strong> Trabajo con marcos ágiles buscando siempre optimizar procesos y flujos de trabajo.
          </li>
        </ul>
      </div>

      <p class="text-emerald-700 dark:text-emerald-400 font-medium pt-1">
        Actualmente continúo profundizando en Project Management y perfeccionando mi nivel de inglés para liderar iniciativas de alto impacto.
      </p>
    </div>
  </div>
</div>

<!-- MODAL SKILLS -->
<div id="modal-skills" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl max-w-lg w-full p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800 mb-4">
      <div class="flex items-center gap-2">
        <span class="text-xl">⚡</span>
        <h3 class="font-bold text-base text-slate-900 dark:text-white">Core Skills</h3>
      </div>
      <button class="close-info-modal text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xl font-bold cursor-pointer">✕</button>
    </div>
    <div class="space-y-4">
      {skills.map((category) => (
        <div>
          <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 block mb-1.5">{category.group}</span>
          <div class="flex flex-wrap gap-1.5">
            {category.items.map((item) => (
              <span class="text-xs bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 font-medium px-2.5 py-1 rounded-md border border-emerald-200/60 dark:border-emerald-800/60">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<!-- MODAL EDUCACIÓN -->
<div id="modal-edu" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl max-w-lg w-full p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800 mb-4">
      <div class="flex items-center gap-2">
        <span class="text-xl">🎓</span>
        <h3 class="font-bold text-base text-slate-900 dark:text-white">Educación & Certificaciones</h3>
      </div>
      <button class="close-info-modal text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xl font-bold cursor-pointer">✕</button>
    </div>
    <div class="space-y-3">
      {education.map((item) => (
        <div class="bg-slate-50 dark:bg-slate-950 p-3 rounded-lg border border-slate-200/60 dark:border-slate-800/60 flex justify-between items-center text-xs">
          <div>
            <p class="font-semibold text-slate-800 dark:text-slate-200">{item.title}</p>
            <p class="text-slate-500 dark:text-slate-400 text-[11px]">{item.entity}</p>
          </div>
          <span class="font-mono text-emerald-600 dark:text-emerald-400 font-bold shrink-0 ml-2">{item.year}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  const sidebar = document.getElementById('sidebar');
  const sidebarToggle = document.getElementById('sidebar-toggle');
  const sidebarTexts = document.querySelectorAll('.sidebar-text');
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const sidebarBackdrop = document.getElementById('sidebar-backdrop');

  // Modales
  const modalAbout = document.getElementById('modal-about');
  const modalSkills = document.getElementById('modal-skills');
  const modalEdu = document.getElementById('modal-edu');

  const btnOpenAbout = document.getElementById('btn-open-about');
  const btnOpenSkills = document.getElementById('btn-open-skills');
  const btnOpenEdu = document.getElementById('btn-open-edu');

  const closeButtons = document.querySelectorAll('.close-info-modal');

  // Desktop Toggle del Sidebar (Contraer)
  sidebarToggle?.addEventListener('click', () => {
    sidebar?.classList.toggle('lg:w-64');
    sidebar?.classList.toggle('lg:w-16');
    sidebarTexts.forEach(el => el.classList.toggle('hidden'));
    sidebarToggle.classList.toggle('rotate-180');
  });

  // Mobile Drawer Toggle
  function toggleMobileMenu() {
    sidebar?.classList.toggle('-translate-x-full');
    sidebarBackdrop?.classList.toggle('hidden');
  }

  mobileMenuButton?.addEventListener('click', toggleMobileMenu);
  sidebarBackdrop?.addEventListener('click', toggleMobileMenu);

  // Funciones para abrir modales y cerrar menú mobile si está abierto
  function openModal(modal: HTMLElement | null) {
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    if (window.innerWidth < 1024 && !sidebar?.classList.contains('-translate-x-full')) {
      toggleMobileMenu();
    }
  }

  function closeModal(modal: HTMLElement | null) {
    if (!modal) return;
    modal.classList.remove('flex');
    modal.classList.add('hidden');
  }

  btnOpenAbout?.addEventListener('click', () => openModal(modalAbout));
  btnOpenSkills?.addEventListener('click', () => openModal(modalSkills));
  btnOpenEdu?.addEventListener('click', () => openModal(modalEdu));

  closeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      closeModal(modalAbout);
      closeModal(modalSkills);
      closeModal(modalEdu);
    });
  });

  // Cerrar al hacer clic fuera del contenido del modal
  [modalAbout, modalSkills, modalEdu].forEach(modal => {
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal(modal);
      }
    });
  });
</script>