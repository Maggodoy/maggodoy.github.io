---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Board from '../components/Board.astro';
import CardModal from '../components/CardModal.astro';
import boardData from '../data/boardData.json';

const profile = boardData.profile;
const columns = boardData.columns;
---

<Layout title={`${profile.name} | Portfolio`} profile={profile}>
  <div class="w-full">
    <!-- Componente de Cabecera y Filtros -->
    <Header profile={profile} />

    <!-- Tablero Kanban Modular -->
    <Board columns={columns} />

    <!-- Modal de Tickets -->
    <CardModal />
  </div>
</Layout>

<script>
  // Lógica de filtrado por rol y apertura del modal de tarjetas
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.card-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const selectedRole = btn.getAttribute('data-role');

      filterBtns.forEach(b => {
        b.classList.remove('bg-emerald-600', 'text-white');
        b.classList.add('bg-slate-200', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
      });
      btn.classList.remove('bg-slate-200', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
      btn.classList.add('bg-emerald-600', 'text-white');

      cards.forEach(card => {
        const cardRole = card.getAttribute('data-role');
        if (selectedRole === 'All' || cardRole === selectedRole) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  const modalOverlay = document.getElementById('modal-overlay');
  const modalClose = document.getElementById('modal-close');

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const key = card.getAttribute('data-key') || '';
      const type = card.getAttribute('data-type') || '';
      const role = card.getAttribute('data-role') || '';
      const summary = card.getAttribute('data-summary') || '';
      const description = card.getAttribute('data-description') || '';
      const criteria = JSON.parse(card.getAttribute('data-criteria') || '[]');
      const points = card.getAttribute('data-points') || '';
      const priority = card.getAttribute('data-priority') || '';

      document.getElementById('modal-key')!.textContent = key;
      document.getElementById('modal-type-icon')!.textContent = type === 'Story' ? '📗' : '🔹';
      document.getElementById('modal-summary')!.textContent = summary;
      document.getElementById('modal-description')!.textContent = description;
      document.getElementById('modal-role')!.textContent = role;
      document.getElementById('modal-priority')!.textContent = priority;
      document.getElementById('modal-points')!.textContent = points;

      const criteriaList = document.getElementById('modal-criteria')!;
      criteriaList.innerHTML = criteria.map((c: string) => `
        <li class="flex items-start gap-2 bg-slate-50 dark:bg-slate-950 p-2 rounded border border-slate-200 dark:border-slate-800/40">
          <input type="checkbox" checked disabled class="mt-1 accent-emerald-600">
          <span>${c}</span>
        </li>
      `).join('');

      modalOverlay?.classList.remove('hidden');
      modalOverlay?.classList.add('flex');
    });
  });

  modalClose?.addEventListener('click', () => {
    modalOverlay?.classList.remove('flex');
    modalOverlay?.classList.add('hidden');
  });

  modalOverlay?.addEventListener('click', (e) => {
    if (e.target === modalOverlay) {
      modalOverlay.classList.remove('flex');
      modalOverlay.classList.add('hidden');
    }
  });
</script>