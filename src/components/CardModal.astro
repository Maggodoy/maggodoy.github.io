<script>
  // Capturamos el modal y el botón de cierre
  const modal = document.getElementById('cardModal') || document.getElementById('card-modal');
  const closeBtn = document.getElementById('closeModal') || document.getElementById('close-modal');

  // Función para cerrar el modal
  const closeModal = () => {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  };

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Escuchar el evento que emiten las tarjetas al hacer clic
  document.addEventListener('open-card-modal', (e: any) => {
    const data = e.detail;
    if (!data || !modal) return;

    // Actualizar Textos Básicos (buscando por ID de tu plantilla)
    const setContent = (id: string, value: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    };

    setContent('modal-key', data.key || '');
    setContent('modal-type', data.type || '');
    setContent('modal-title', data.title || '');
    setContent('modal-description', data.description || data.summary || 'Sin descripción disponible.');
    setContent('modal-role', data.role || '');
    setContent('modal-priority', data.priority || 'Medium');
    setContent('modal-points', data.points ? `${data.points} pts` : '-');

    // Renderizar Criterios de Aceptación (Buscamos la lista 'modal-criteria')
    const criteriaList = document.getElementById('modal-criteria');
    if (criteriaList) {
      criteriaList.innerHTML = '';
      if (data.criteria && Array.isArray(data.criteria) && data.criteria.length > 0) {
        data.criteria.forEach((criterion: string) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-2 bg-slate-50 dark:bg-slate-900/50 p-2.5 rounded-lg border border-slate-200/60 dark:border-slate-700/60 text-sm text-slate-700 dark:text-slate-300';
          li.innerHTML = `<span class="text-emerald-500 font-bold">✓</span> <span>${criterion}</span>`;
          criteriaList.appendChild(li);
        });
      } else {
        criteriaList.innerHTML = '<li class="text-slate-400 italic text-xs">Sin criterios de aceptación especificados.</li>';
      }
    }

    // Mostrar el modal
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  });
</script>