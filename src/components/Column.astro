---
import Card from './Card.astro';

interface Props {
  title: string;
  cards: Array<any>;
}

const { title, cards } = Astro.props;
---

<div class="bg-slate-100 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl p-4 flex flex-col gap-4 shadow-sm transition-colors">
  <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
    <h2 class="font-semibold text-slate-800 dark:text-slate-200 text-sm">{title}</h2>
    <span class="bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs px-2 py-0.5 rounded-full border border-slate-300 dark:border-slate-700">
      {cards.length}
    </span>
  </div>

  <div class="flex flex-col gap-3">
    {cards.map((card) => (
      <Card {...card} />
    ))}
  </div>
</div>